-- type definition
define A : Type 0;
define x : A;

define Int : Type 0;

let foo : Int = 10;

let baz : A = x;

let f : A -> A = \a : A . a;

-- inductive type introduction
data nat : A where
| zero : nat
| suc : nat -> nat
.

let z : nat = zero;
let one : nat = suc zero;
let two : nat = suc (suc zero);

-- list operations
let intList : Int list = [1, 2, 3];
let flist : Int -> Int list = \xs : Int . [3,2];


let inc : Int -> Int = \x : Int . x + 1;
let nums : Int list = [1, 2, 3, 4];

let doubledNums : Int list = map (\x : Int . 8 + x) nums;

let addTen : Int -> Int = \x : Int . x + 10;
let numsWithTen : Int list = map addTen (map inc nums);

let addexplicit : Int list = map addTen [3,4,2];

-- Top-level type definition
let addTwo: Int -> Int
addTwo = \x : Int . x + 2;
