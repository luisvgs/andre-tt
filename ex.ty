-- type definition
define A : Type 0;
define x : A;

define Int : Type 0;
define Bool: Type 0;

let foo : Int = 10;

let baz : A = x;

let f : A -> A = \a : A . a;

-- inductive type introduction
data nat : A where
| zero : nat
| suc : nat -> nat
.

let z : nat = zero;
let one : nat = suc zero;
let two : nat = suc (suc zero);

-- list operations
let intList : Int list = [1, 2, 3];
let flist : Int -> Int list = \xs : Int . [3,2];


let inc : Int -> Int = \x : Int . x + 1;
let nums : Int list = [1, 2, 3, 4];

let doubledNums : Int list = map (\x : Int . 8 + x) nums;

let addTen x : Int -> Int = x + 10;
let numsWithTen : Int list = map addTen (map inc nums);

let addexplicit : Int list =
    map addTen [3,4,2];

let f m : Int -> Bool = match m with
       | 3 -> True
       | _ -> False
 .

f 3;

let sum n : Int -> Int = n + 10;
sum 30;

let sub n : Int -> Int = n - 10;
sub 20;

let lessthan b : Int -> Bool = b < 20;
lessthan 9;
